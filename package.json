{
  "name": "cmxplayer-ndi",
  "version": "3.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "rebuild": "electron-rebuild"
  },
  "build": {
    "appId": "com.antigravity.cmxplayer-ndi",
    "productName": "CMX Player NDI",
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "node_modules/grandiose/build/Release/",
        "to": ".",
        "filter": ["**/*.node"]
      }
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "eventsource": "^4.1.0",
    "express": "^4.18.2",
    "grandiose": "^0.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  }
}